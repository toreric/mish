#!/bin/bash

# This is the production server version of 'mish-restart-pm2'

pwd=$PWD
echo
# Go to the web home directory:
cd /var/www/mish/ || exit 1 # Break if the directory is missing

# ==============================================================================
# TROUBLESHOOTING / COLD START CLEANUP
# ==============================================================================
# If the server, at cold start, falls back into using outdated compiled files
# (e.g., node module/binary mismatches after major system/node upgrades):
#
# 1. pm2 unstartup (and follow the printed sudo env command advice)
# 2. pm2 kill
# 3. rm -rf ~/.pm2/dump.pm2 ~/.pm2/dump.pm2.bak
# 4. pm2 startup (and follow the printed sudo env command advice)
# 5. Ensure the symlink /usr/bin/node points to the actual used node version
#    (perhaps run: sudo ln -sf $(which node) /usr/bin/node,
#    perhaps after running: nvm use <version>, cf. below)
# 6. Run this start script from scratch (after adjustings for the upgrade)
# ==============================================================================

# Ensure that the script finds the NVM environment
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
# Force the use of the specific Node version
nvm use 22.22.0

# Below, modify to reflect whether NPM or PNPM is used:
# Pnpm has been used since 2024 or earlier
# Generally, pnpm is superior, and don't mix!
echo -n "  Run pnpm install? (y/N): " # NOTE: for PNPM
#echo -n "  Run npm install? (y/N): " # NOTE: for NPM
read yN

echo
if [[ $yN == "y" || $yN == "yes" ]]; then

  # Clean all for PNPM install
  rm -rf node_modules pnpm-lock.yaml tmp dist
  #pnpm store prune
  #pnpm store prune clears pnpm's global cache on the server. The whole point of pnpm is
  # that it saves all the packages in a central cache so that the next pnpm install is
  # lightning fast (since it just hardlinks the files). Clearing the cache with prune on
  # every reinstall will force the server to download all packages from the internet again.
  # It eats up bandwidth and takes much longer.
  #rm -rf node_modules # Minimum(?) clean for npm

  pnpm install # Install node_modules with PNPM, using package.json, producing the pnpm-lock.yaml file
  #npm install # Install node_modules with NPM, using package.json, producing another file
  # ... changed dec.2018 to YARN, reverted july 2019, later (2023?) changed to PNPM
  #sudo yarn  # Update node_modules using package.json
  echo "##### Installation of node_modules is complete if no errors or severe complains appeared"
fi

appname=mish
# IMDB_HOME and IMDB_ROOT will be used as server environment settings
# NOTE: IMDB_HOME='server database (datastore) directory' MUST NOT end with slash
export IMDB_HOME='/media/raid1' # Do not end with '/'
export IMDB_ROOT='""' # Means that user selects, important duoble quoted syntax (don´t use '' or "")!
# NOTE: IMDB_ROOT='the preselected album collection' MUST NOT have any slashes
export IMDB_ROOT='MISH'  # preselected, without '/'es
port=3000

echo "##### Restarting $appname service with new environment"
# Ensures right Node environment at restart, or starts if missing
pm2 restart $appname --update-env || pm2 start server.js -i max --name $appname -- $IMDB_HOME $IMDB_ROOT $port
pm2 flush
pm2 save

cd $pwd || exit
#pm2 logs --lines 24 $appname
pm2 logs
